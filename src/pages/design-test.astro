---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="GradeVine — Dashboard Design Test"
  description="Design variations for the grading dashboard."
>
  <div class="dt-page">
    <header class="dt-header">
      <h1>Dashboard Design Variations</h1>
      <p class="dt-subtitle">Comparing three approaches for bringing the iOS design language to the web.</p>
    </header>

    <!-- ================================================================== -->
    <!-- VARIATION A: BRUTALIST WEB                                          -->
    <!-- ================================================================== -->
    <section class="dt-section">
      <div class="dt-section-label">VARIATION A</div>
      <h2>Brutalist Web</h2>
      <p class="dt-desc">Full iOS brutalist aesthetic: heavy tracked uppercase headers, black section bars, monospaced numerals, square avatars, minimal rounding. Matches the batch-scan sheet design language.</p>

      <!-- A: Dashboard Header -->
      <h3 class="dt-component-label">Dashboard Header</h3>
      <div class="a-dashboard-header">
        <div class="a-dashboard-header-inner">
          <div class="a-header-brand">
            <span class="a-header-logo">G</span>
            <span class="a-header-title">GRADEVINE</span>
          </div>
          <div class="a-header-user">
            <span class="a-header-user-name">MOSES HARDING</span>
            <button class="a-header-signout">SIGN OUT</button>
          </div>
        </div>
      </div>

      <!-- A: Breadcrumb -->
      <h3 class="dt-component-label">Breadcrumb</h3>
      <div class="dt-mock-bg">
        <nav class="a-breadcrumb">
          <button class="a-breadcrumb-link">COURSES</button>
          <span class="a-breadcrumb-sep">/</span>
          <button class="a-breadcrumb-link">US HISTORY</button>
          <span class="a-breadcrumb-sep">/</span>
          <span class="a-breadcrumb-current">CH. 12 QUIZ</span>
        </nav>
      </div>

      <!-- A: Course Cards -->
      <h3 class="dt-component-label">Course Cards</h3>
      <div class="dt-mock-bg">
        <div class="a-course-grid">
          <div class="a-course-card" style="--course-color: #E41749">
            <div class="a-course-card-accent"></div>
            <div class="a-course-card-body">
              <div class="a-course-card-name">US History</div>
              <div class="a-course-card-meta">
                <span class="a-course-meta-num">24</span>
                <span class="a-course-meta-label">STUDENTS</span>
                <span class="a-course-meta-dot"></span>
                <span class="a-course-meta-num">6</span>
                <span class="a-course-meta-label">ASSIGNMENTS</span>
              </div>
            </div>
          </div>
          <div class="a-course-card" style="--course-color: #1565C0">
            <div class="a-course-card-accent"></div>
            <div class="a-course-card-body">
              <div class="a-course-card-name">AP Biology</div>
              <div class="a-course-card-meta">
                <span class="a-course-meta-num">18</span>
                <span class="a-course-meta-label">STUDENTS</span>
                <span class="a-course-meta-dot"></span>
                <span class="a-course-meta-num">3</span>
                <span class="a-course-meta-label">ASSIGNMENTS</span>
              </div>
            </div>
          </div>
          <div class="a-course-card" style="--course-color: #6F00FF">
            <div class="a-course-card-accent"></div>
            <div class="a-course-card-body">
              <div class="a-course-card-name">English 10</div>
              <div class="a-course-card-meta">
                <span class="a-course-meta-num">31</span>
                <span class="a-course-meta-label">STUDENTS</span>
                <span class="a-course-meta-dot"></span>
                <span class="a-course-meta-num">8</span>
                <span class="a-course-meta-label">ASSIGNMENTS</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- A: Student Rows -->
      <h3 class="dt-component-label">Student List</h3>
      <div class="dt-mock-bg">
        <div class="a-section-bar">SUBMISSIONS &mdash; 24 STUDENTS</div>
        <div class="a-progress-bar">
          <div class="a-progress-fill" style="width: 62%"></div>
        </div>
        <div class="a-student-list">
          <div class="a-student-row">
            <div class="a-avatar" style="background: #E41749">A</div>
            <span class="a-student-name">Alvarez, Maria</span>
            <span class="a-student-badge a-badge-graded">GRADED</span>
            <span class="a-student-score">8 / 10</span>
            <span class="a-student-arrow">&rarr;</span>
          </div>
          <div class="a-student-row">
            <div class="a-avatar" style="background: #E41749">C</div>
            <span class="a-student-name">Chen, David</span>
            <span class="a-student-badge a-badge-partial">PARTIAL</span>
            <span class="a-student-score">3 / 10</span>
            <span class="a-student-arrow">&rarr;</span>
          </div>
          <div class="a-student-row">
            <div class="a-avatar" style="background: #E41749">J</div>
            <span class="a-student-name">Johnson, Tyler</span>
            <span class="a-student-badge a-badge-ungraded">UNGRADED</span>
            <span class="a-student-score">&mdash;</span>
            <span class="a-student-arrow">&rarr;</span>
          </div>
        </div>
      </div>

      <!-- A: Grading Panel -->
      <h3 class="dt-component-label">Grading Panel</h3>
      <div class="dt-mock-bg" style="max-width: 440px">
        <div class="a-grade-panel">
          <div class="a-grade-panel-header">
            <span class="a-grade-panel-title">GRADING</span>
            <span class="a-grade-panel-total">8 / 10</span>
          </div>
          <div class="a-grade-questions">
            <div class="a-grade-q">
              <div class="a-grade-q-header">
                <div class="a-grade-q-num">01</div>
                <div class="a-grade-q-info">
                  <div class="a-grade-q-label">Question 1</div>
                  <div class="a-grade-q-prompt">What were the main causes of WWI?</div>
                </div>
                <div class="a-grade-q-input-group">
                  <input type="text" class="a-grade-input" value="4" />
                  <span class="a-grade-max">/ 5</span>
                </div>
              </div>
              <div class="a-ai-hint a-ai-correct">
                <span class="a-ai-label">AI: CORRECT</span>
                <span class="a-ai-reason">Student identifies all 4 MAIN causes</span>
              </div>
            </div>
            <div class="a-grade-q">
              <div class="a-grade-q-header">
                <div class="a-grade-q-num">02</div>
                <div class="a-grade-q-info">
                  <div class="a-grade-q-label">Question 2</div>
                  <div class="a-grade-q-prompt">Describe the Treaty of Versailles.</div>
                </div>
                <div class="a-grade-q-input-group">
                  <input type="text" class="a-grade-input" value="4" />
                  <span class="a-grade-max">/ 5</span>
                </div>
              </div>
              <div class="a-ai-hint a-ai-partial">
                <span class="a-ai-label">AI: PARTIAL</span>
                <span class="a-ai-reason">Missing key terms about reparations</span>
              </div>
            </div>
          </div>
          <div class="a-scan-feedback">
            <div class="a-section-label">OVERALL FEEDBACK</div>
            <textarea class="a-feedback-input" rows="2" placeholder="Add feedback for this student..."></textarea>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- VARIATION B: REFINED CURRENT                                        -->
    <!-- ================================================================== -->
    <section class="dt-section">
      <div class="dt-section-label">VARIATION B</div>
      <h2>Refined Current</h2>
      <p class="dt-desc">Keep the current clean card-based SaaS feel, but elevate with student avatars, richer course color usage, better grading panel hierarchy, and a branded header.</p>

      <!-- B: Dashboard Header -->
      <h3 class="dt-component-label">Dashboard Header</h3>
      <div class="b-dashboard-header">
        <div class="b-dashboard-header-inner">
          <div class="b-header-brand">
            <img src="/favicon.svg" alt="" width="28" height="28" class="b-header-logo" />
            <span class="b-header-title">GradeVine Dashboard</span>
          </div>
          <div class="b-header-user">
            <span class="b-user-name">Moses Harding</span>
            <div class="b-user-avatar">MH</div>
          </div>
        </div>
      </div>

      <!-- B: Breadcrumb -->
      <h3 class="dt-component-label">Breadcrumb</h3>
      <div class="dt-mock-bg">
        <nav class="b-breadcrumb">
          <button class="b-breadcrumb-link">Courses</button>
          <span class="b-breadcrumb-chevron">&rsaquo;</span>
          <button class="b-breadcrumb-link">US History</button>
          <span class="b-breadcrumb-chevron">&rsaquo;</span>
          <span class="b-breadcrumb-current">Ch. 12 Quiz</span>
        </nav>
      </div>

      <!-- B: Course Cards -->
      <h3 class="dt-component-label">Course Cards</h3>
      <div class="dt-mock-bg">
        <div class="b-course-grid">
          <div class="b-course-card" style="--course-color: #E41749">
            <div class="b-course-card-color"></div>
            <div class="b-course-card-body">
              <h3>US History</h3>
              <div class="b-course-card-stats">
                <div class="b-stat">
                  <span class="b-stat-num">24</span>
                  <span class="b-stat-label">students</span>
                </div>
                <div class="b-stat-divider"></div>
                <div class="b-stat">
                  <span class="b-stat-num">6</span>
                  <span class="b-stat-label">assignments</span>
                </div>
              </div>
              <div class="b-course-sections">
                <span class="b-section-chip">Period 1</span>
                <span class="b-section-chip">Period 3</span>
              </div>
            </div>
          </div>
          <div class="b-course-card" style="--course-color: #1565C0">
            <div class="b-course-card-color"></div>
            <div class="b-course-card-body">
              <h3>AP Biology</h3>
              <div class="b-course-card-stats">
                <div class="b-stat">
                  <span class="b-stat-num">18</span>
                  <span class="b-stat-label">students</span>
                </div>
                <div class="b-stat-divider"></div>
                <div class="b-stat">
                  <span class="b-stat-num">3</span>
                  <span class="b-stat-label">assignments</span>
                </div>
              </div>
            </div>
          </div>
          <div class="b-course-card" style="--course-color: #6F00FF">
            <div class="b-course-card-color"></div>
            <div class="b-course-card-body">
              <h3>English 10</h3>
              <div class="b-course-card-stats">
                <div class="b-stat">
                  <span class="b-stat-num">31</span>
                  <span class="b-stat-label">students</span>
                </div>
                <div class="b-stat-divider"></div>
                <div class="b-stat">
                  <span class="b-stat-num">8</span>
                  <span class="b-stat-label">assignments</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- B: Student Rows -->
      <h3 class="dt-component-label">Student List</h3>
      <div class="dt-mock-bg">
        <div class="b-list-header">
          <h2>Submissions</h2>
          <span class="b-list-count">15 of 24 graded</span>
        </div>
        <div class="b-progress-bar">
          <div class="b-progress-fill" style="width: 62%"></div>
        </div>
        <div class="b-student-list">
          <div class="b-student-row">
            <div class="b-avatar" style="--avatar-color: #E41749">A</div>
            <div class="b-student-info">
              <span class="b-student-name">Alvarez, Maria</span>
              <span class="b-student-score-inline">8 / 10 pts</span>
            </div>
            <span class="b-student-badge b-badge-graded">Graded</span>
            <span class="b-row-chevron">&rsaquo;</span>
          </div>
          <div class="b-student-row">
            <div class="b-avatar" style="--avatar-color: #E41749">C</div>
            <div class="b-student-info">
              <span class="b-student-name">Chen, David</span>
              <span class="b-student-score-inline">3 / 10 pts</span>
            </div>
            <span class="b-student-badge b-badge-partial">Partial</span>
            <span class="b-row-chevron">&rsaquo;</span>
          </div>
          <div class="b-student-row">
            <div class="b-avatar" style="--avatar-color: #E41749">J</div>
            <div class="b-student-info">
              <span class="b-student-name">Johnson, Tyler</span>
            </div>
            <span class="b-student-badge b-badge-ungraded">Ungraded</span>
            <span class="b-row-chevron">&rsaquo;</span>
          </div>
        </div>
      </div>

      <!-- B: Grading Panel -->
      <h3 class="dt-component-label">Grading Panel</h3>
      <div class="dt-mock-bg" style="max-width: 440px">
        <div class="b-grade-panel">
          <div class="b-grade-panel-header">
            <h3>Grading</h3>
            <div class="b-grade-panel-status">
              <span class="b-save-badge b-save-saved">Saved</span>
              <span class="b-grade-total">8 / 10</span>
            </div>
          </div>
          <div class="b-grade-questions">
            <div class="b-grade-q">
              <div class="b-grade-q-top">
                <span class="b-grade-q-label">Q1</span>
                <span class="b-grade-q-prompt">What were the main causes of WWI?</span>
                <div class="b-grade-q-input-group">
                  <input type="text" class="b-grade-input" value="4" />
                  <span class="b-grade-max">/ 5</span>
                </div>
              </div>
              <div class="b-ai-hint b-ai-correct">
                <span class="b-ai-icon">&#x2713;</span>
                <span class="b-ai-text"><strong>Correct</strong> &mdash; Student identifies all 4 MAIN causes</span>
              </div>
            </div>
            <div class="b-grade-q">
              <div class="b-grade-q-top">
                <span class="b-grade-q-label">Q2</span>
                <span class="b-grade-q-prompt">Describe the Treaty of Versailles.</span>
                <div class="b-grade-q-input-group">
                  <input type="text" class="b-grade-input" value="4" />
                  <span class="b-grade-max">/ 5</span>
                </div>
              </div>
              <div class="b-ai-hint b-ai-partial">
                <span class="b-ai-icon">~</span>
                <span class="b-ai-text"><strong>Partial</strong> &mdash; Missing key terms about reparations</span>
              </div>
            </div>
          </div>
          <div class="b-scan-feedback">
            <label class="b-feedback-label">Overall Feedback</label>
            <textarea class="b-feedback-input" rows="2" placeholder="Add feedback for this student..."></textarea>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- VARIATION C: HYBRID                                                 -->
    <!-- ================================================================== -->
    <section class="dt-section">
      <div class="dt-section-label">VARIATION C</div>
      <h2>Hybrid</h2>
      <p class="dt-desc">Brutalist accents (tracked section labels, colored left borders, monospaced question numbers) layered onto the clean card layout. The best of both worlds &mdash; recognizable as the same app, but web-native.</p>

      <!-- C: Dashboard Header -->
      <h3 class="dt-component-label">Dashboard Header</h3>
      <div class="c-dashboard-header">
        <div class="c-dashboard-header-inner">
          <div class="c-header-left">
            <span class="c-header-brand">GRADEVINE</span>
            <span class="c-header-divider"></span>
            <span class="c-header-subtitle">Dashboard</span>
          </div>
          <div class="c-header-user">
            <span class="c-header-user-name">Moses Harding</span>
          </div>
        </div>
      </div>

      <!-- C: Breadcrumb -->
      <h3 class="dt-component-label">Breadcrumb</h3>
      <div class="dt-mock-bg">
        <nav class="c-breadcrumb">
          <button class="c-breadcrumb-link">Courses</button>
          <span class="c-breadcrumb-sep">&rarr;</span>
          <button class="c-breadcrumb-link">US History</button>
          <span class="c-breadcrumb-sep">&rarr;</span>
          <span class="c-breadcrumb-current">Ch. 12 Quiz</span>
        </nav>
      </div>

      <!-- C: Course Cards -->
      <h3 class="dt-component-label">Course Cards</h3>
      <div class="dt-mock-bg">
        <div class="c-section-label">YOUR COURSES</div>
        <div class="c-course-grid">
          <div class="c-course-card" style="--course-color: #E41749">
            <div class="c-course-card-left"></div>
            <div class="c-course-card-body">
              <div class="c-course-card-name">US History</div>
              <div class="c-course-card-meta">
                <span class="c-meta-value">24</span> students
                <span class="c-meta-dot">&middot;</span>
                <span class="c-meta-value">6</span> assignments
              </div>
            </div>
            <span class="c-course-card-arrow">&rarr;</span>
          </div>
          <div class="c-course-card" style="--course-color: #1565C0">
            <div class="c-course-card-left"></div>
            <div class="c-course-card-body">
              <div class="c-course-card-name">AP Biology</div>
              <div class="c-course-card-meta">
                <span class="c-meta-value">18</span> students
                <span class="c-meta-dot">&middot;</span>
                <span class="c-meta-value">3</span> assignments
              </div>
            </div>
            <span class="c-course-card-arrow">&rarr;</span>
          </div>
          <div class="c-course-card" style="--course-color: #6F00FF">
            <div class="c-course-card-left"></div>
            <div class="c-course-card-body">
              <div class="c-course-card-name">English 10</div>
              <div class="c-course-card-meta">
                <span class="c-meta-value">31</span> students
                <span class="c-meta-dot">&middot;</span>
                <span class="c-meta-value">8</span> assignments
              </div>
            </div>
            <span class="c-course-card-arrow">&rarr;</span>
          </div>
        </div>
      </div>

      <!-- C: Student Rows -->
      <h3 class="dt-component-label">Student List</h3>
      <div class="dt-mock-bg">
        <div class="c-section-label">SUBMISSIONS &mdash; 15 OF 24 GRADED</div>
        <div class="c-progress-bar">
          <div class="c-progress-fill" style="width: 62%"></div>
        </div>
        <div class="c-student-list">
          <div class="c-student-row">
            <div class="c-avatar" style="--avatar-color: #E41749">A</div>
            <div class="c-student-info">
              <span class="c-student-name">Alvarez, Maria</span>
            </div>
            <span class="c-student-badge c-badge-graded">GRADED</span>
            <span class="c-student-score">8 / 10</span>
            <span class="c-row-arrow">&rarr;</span>
          </div>
          <div class="c-student-row">
            <div class="c-avatar" style="--avatar-color: #E41749">C</div>
            <div class="c-student-info">
              <span class="c-student-name">Chen, David</span>
            </div>
            <span class="c-student-badge c-badge-partial">PARTIAL</span>
            <span class="c-student-score">3 / 10</span>
            <span class="c-row-arrow">&rarr;</span>
          </div>
          <div class="c-student-row">
            <div class="c-avatar" style="--avatar-color: #E41749">J</div>
            <div class="c-student-info">
              <span class="c-student-name">Johnson, Tyler</span>
            </div>
            <span class="c-student-badge c-badge-ungraded">UNGRADED</span>
            <span class="c-student-score">&mdash;</span>
            <span class="c-row-arrow">&rarr;</span>
          </div>
        </div>
      </div>

      <!-- C: Grading Panel -->
      <h3 class="dt-component-label">Grading Panel</h3>
      <div class="dt-mock-bg" style="max-width: 440px">
        <div class="c-grade-panel">
          <div class="c-grade-panel-header">
            <div class="c-grade-panel-left">
              <span class="c-grade-section-label">GRADING</span>
              <span class="c-grade-total">8 / 10</span>
            </div>
            <span class="c-save-badge c-save-saved">Saved</span>
          </div>
          <div class="c-grade-questions">
            <div class="c-grade-q">
              <div class="c-grade-q-left-border" style="--q-color: #248a3d"></div>
              <div class="c-grade-q-content">
                <div class="c-grade-q-header">
                  <span class="c-grade-q-num">01</span>
                  <div class="c-grade-q-info">
                    <div class="c-grade-q-label">Question 1</div>
                    <div class="c-grade-q-prompt">What were the main causes of WWI?</div>
                  </div>
                  <div class="c-grade-q-input-group">
                    <input type="text" class="c-grade-input" value="4" />
                    <span class="c-grade-max">/ 5</span>
                  </div>
                </div>
                <div class="c-ai-hint c-ai-correct">
                  <strong>Correct</strong> &mdash; Student identifies all 4 MAIN causes
                </div>
              </div>
            </div>
            <div class="c-grade-q">
              <div class="c-grade-q-left-border" style="--q-color: #946800"></div>
              <div class="c-grade-q-content">
                <div class="c-grade-q-header">
                  <span class="c-grade-q-num">02</span>
                  <div class="c-grade-q-info">
                    <div class="c-grade-q-label">Question 2</div>
                    <div class="c-grade-q-prompt">Describe the Treaty of Versailles.</div>
                  </div>
                  <div class="c-grade-q-input-group">
                    <input type="text" class="c-grade-input" value="4" />
                    <span class="c-grade-max">/ 5</span>
                  </div>
                </div>
                <div class="c-ai-hint c-ai-partial">
                  <strong>Partial</strong> &mdash; Missing key terms about reparations
                </div>
              </div>
            </div>
          </div>
          <div class="c-scan-feedback">
            <div class="c-section-label" style="margin-bottom: 8px">OVERALL FEEDBACK</div>
            <textarea class="c-feedback-input" rows="2" placeholder="Add feedback for this student..."></textarea>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- STUDENT NAV BAR COMPARISON                                          -->
    <!-- ================================================================== -->
    <section class="dt-section">
      <div class="dt-section-label">STUDENT NAVIGATION BAR</div>
      <h2>Nav Bar Comparison</h2>

      <h3 class="dt-component-label">A: Brutalist</h3>
      <div class="dt-mock-bg">
        <div class="a-student-nav">
          <button class="a-nav-btn">&larr; PREV</button>
          <div class="a-nav-center">
            <div class="a-avatar" style="background: #E41749">A</div>
            <span class="a-nav-name">ALVAREZ, MARIA</span>
            <span class="a-nav-pos">3 / 24</span>
          </div>
          <button class="a-nav-btn">NEXT &rarr;</button>
        </div>
      </div>

      <h3 class="dt-component-label">B: Refined</h3>
      <div class="dt-mock-bg">
        <div class="b-student-nav">
          <button class="b-nav-btn">&larr; Previous</button>
          <div class="b-nav-center">
            <div class="b-avatar" style="--avatar-color: #E41749">A</div>
            <div class="b-nav-info">
