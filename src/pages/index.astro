---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="GradeVine - Grade on the go. Powered by AI."
  description="GradeVine helps teachers digitize handwritten student assignments using AI-powered transcription, keyword matching, and smart grading tools."
>
  <!-- Header -->
  <header class="header">
    <nav class="nav">
      <div class="logo">
        <!-- Replace with your logo image -->
        <span class="logo-text">GradeVine</span>
      </div>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#pricing">Pricing</a>
        <a href="#" class="btn btn-small">Download</a>
      </div>
    </nav>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <h1>Grade on the go.<br /><span class="highlight">Powered by AI.</span></h1>
      <p class="hero-subtitle">
        Digitize handwritten assignments, auto-match students, and grade
        smarter — all from your iPhone.
      </p>
      <div class="hero-cta">
        <a href="#" class="btn btn-primary">
          <svg class="apple-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
          </svg>
          Download on the App Store
        </a>
      </div>
      <div class="hero-image">
        <!-- Replace with app screenshot -->
        <div class="screenshot-placeholder">
          <span>App Screenshot</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="features">
    <div class="container">
      <h2>Everything teachers need to grade faster</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
              <path d="M12 18v-6" /><path d="M9 15l3-3 3 3" />
            </svg>
          </div>
          <h3>AI Transcription</h3>
          <p>
            Snap a photo of any handwritten assignment. GradeVine's AI reads and
            digitizes student responses automatically.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h3>Keyword Matching</h3>
          <p>
            Define answer keywords and let GradeVine highlight matches
            instantly. Spend less time reading, more time teaching.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3>Auto-Match Students</h3>
          <p>
            Scan a stack of papers and GradeVine automatically matches each
            assignment to the right student. No manual sorting.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
            </svg>
          </div>
          <h3>Batch Processing</h3>
          <p>
            Grade an entire class at once. Scan multiple pages, process them
            concurrently, and review results in one view.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
            </svg>
          </div>
          <h3>Google Drive Export</h3>
          <p>
            Export graded assignments and reports directly to Google Drive.
            Keep your records organized and accessible.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <h3>Private & Secure</h3>
          <p>
            Student data stays on your device and syncs privately via iCloud.
            No third-party servers store your students' work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="how-it-works">
    <div class="container">
      <h2>How it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Scan</h3>
          <p>Take photos of handwritten assignments or import PDFs.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Transcribe</h3>
          <p>AI reads handwriting and digitizes every response.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Grade</h3>
          <p>Review transcriptions, use keyword matching, and assign grades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="pricing">
    <div class="container">
      <h2>Simple pricing</h2>
      <p class="pricing-subtitle">Start free. Upgrade when you're ready.</p>
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Free</h3>
          <div class="price">$0</div>
          <ul>
            <li>Scan and transcribe assignments</li>
            <li>Keyword matching</li>
            <li>Student auto-matching</li>
            <li>Limited AI credits</li>
          </ul>
        </div>
        <div class="pricing-card featured">
          <div class="badge">Most Popular</div>
          <h3>Premium</h3>
          <div class="price">$4.99<span>/mo</span></div>
          <ul>
            <li>Everything in Free</li>
            <li>Unlimited AI credits</li>
            <li>Batch processing</li>
            <li>Google Drive export</li>
            <li>Priority support</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <span class="logo-text">GradeVine</span>
          <p>Grade on the go. Powered by AI.</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h4>Product</h4>
            <a href="#features">Features</a>
            <a href="#pricing">Pricing</a>
            <a href="#">Download</a>
          </div>
          <div class="footer-col">
            <h4>Legal</h4>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
          </div>
          <div class="footer-col">
            <h4>Support</h4>
            <a href="mailto:support@gradevine.app">Contact</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} GradeVine. All rights reserved.</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-green-800);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--color-gray-700);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--color-green-700);
    text-decoration: none;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-green-800);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-green-900);
  }

  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    border-radius: 8px;
    background: var(--color-green-800);
    color: #fff !important;
  }

  .btn-small:hover {
    background: var(--color-green-900);
  }

  .apple-icon {
    width: 20px;
    height: 20px;
  }

  /* Hero */
  .hero {
    padding: 8rem 1.5rem 4rem;
    text-align: center;
    background: linear-gradient(180deg, var(--color-green-50) 0%, #fff 100%);
  }

  .hero-content {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-gray-900);
  }

  .highlight {
    color: var(--color-green-700);
  }

  .hero-subtitle {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    color: var(--color-gray-600);
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .hero-cta {
    margin-top: 2rem;
  }

  .hero-image {
    margin-top: 3rem;
  }

  .screenshot-placeholder {
    max-width: 320px;
    height: 580px;
    margin: 0 auto;
    background: var(--color-gray-100);
    border-radius: 24px;
    border: 2px dashed var(--color-gray-300);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray-500);
    font-size: 0.9rem;
  }

  /* Container */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Features */
  .features {
    padding: 5rem 0;
  }

  .features h2 {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-card {
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid var(--color-gray-200);
    transition: box-shadow 0.2s;
  }

  .feature-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: var(--color-green-50);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-green-700);
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  /* How It Works */
  .how-it-works {
    padding: 5rem 0;
    background: var(--color-gray-50);
  }

  .how-it-works h2 {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .step {
    text-align: center;
    max-width: 240px;
  }

  .step-number {
    width: 48px;
    height: 48px;
    background: var(--color-green-800);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    margin: 0 auto 1rem;
  }

  .step h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .step p {
    font-size: 0.9rem;
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  .step-arrow {
    color: var(--color-gray-300);
    flex-shrink: 0;
  }

  /* Pricing */
  .pricing {
    padding: 5rem 0;
  }

  .pricing h2 {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 700;
  }

  .pricing-subtitle {
    text-align: center;
    color: var(--color-gray-600);
    margin-top: 0.5rem;
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .pricing-card {
    padding: 2.5rem 2rem;
    border-radius: 16px;
    border: 1px solid var(--color-gray-200);
    position: relative;
  }

  .pricing-card.featured {
    border-color: var(--color-green-500);
    box-shadow: 0 4px 24px rgba(76, 175, 80, 0.15);
  }

  .badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-green-800);
    color: #fff;
    padding: 0.25rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .pricing-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .price {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-green-800);
    margin-bottom: 1.5rem;
  }

  .price span {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-gray-500);
  }

  .pricing-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pricing-card li {
    font-size: 0.95rem;
    color: var(--color-gray-700);
    padding-left: 1.5rem;
    position: relative;
  }

  .pricing-card li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-green-600);
    font-weight: 700;
  }

  /* Footer */
  .footer {
    padding: 3rem 0 1.5rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  .footer-brand p {
    margin-top: 0.5rem;
    color: var(--color-gray-500);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col h4 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    color: var(--color-gray-700);
    font-size: 0.9rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-gray-200);
    padding-top: 1.5rem;
    text-align: center;
  }

  .footer-bottom p {
    color: var(--color-gray-500);
    font-size: 0.85rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .steps {
      flex-direction: column;
    }

    .step-arrow {
      transform: rotate(90deg);
    }

    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .nav-links a:not(.btn) {
      display: none;
    }

    .footer-content {
      flex-direction: column;
    }

    .footer-links {
      gap: 2rem;
    }
  }
</style>
