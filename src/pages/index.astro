---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="GradeVine - AI that grades papers, not writes them."
  description="GradeVine helps teachers digitize handwritten student assignments using AI-powered transcription, keyword matching, and smart grading tools."
>
  <!-- Header -->
  <header class="header">
    <nav class="nav">
      <div class="logo">
        <span class="logo-text">GradeVine</span>
      </div>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#pricing">Pricing</a>
        <a href="#" class="btn btn-nav">Get Started Free</a>
      </div>
    </nav>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <h1>AI that grades papers,<br /><span class="highlight">not writes them.</span></h1>
      <p class="hero-subtitle">
        Scan handwritten assignments, auto-match students, and grade an entire class set
        in 35 minutes instead of 3 hours — all from your iPhone.
      </p>
      <div class="hero-cta">
        <a href="#" class="btn btn-primary">Get Started for Free</a>
      </div>
      <div class="hero-videos">
        <div class="video-step">
          <div class="video-step-text">
            <span class="video-step-number">1</span>
            <h3>Upload your assignment</h3>
            <p>Snap a photo of your quiz or import a PDF. GradeVine's AI extracts the questions, point values, and structure automatically — no manual setup.</p>
          </div>
          <div class="video-item">
            <video autoplay muted loop playsinline>
              <source src="/videos/2-confirm-questions.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="video-step reverse">
          <div class="video-step-text">
            <span class="video-step-number">2</span>
            <h3>Grade by question, not by paper</h3>
            <p>See every student's answer to the same question side by side. Tap to assign points, swipe to the next student. Grade a full class set of Question 1 in under two minutes.</p>
          </div>
          <div class="video-item">
            <video autoplay muted loop playsinline>
              <source src="/videos/4-grade-student-work.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="video-step">
          <div class="video-step-text">
            <span class="video-step-number">3</span>
            <h3>See who needs help</h3>
            <p>Instantly view class averages, grade distributions, and which students are struggling — then export everything to your gradebook, Google Drive, or as a PDF.</p>
          </div>
          <div class="video-item">
            <video autoplay muted loop playsinline>
              <source src="/videos/6-view-analytics.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy Banner -->
  <section class="privacy-banner">
    <div class="container">
      <div class="privacy-content">
        <svg class="privacy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        <p>Student data stays on your device and syncs privately via your personal iCloud account. Student work is never stored on our servers and is <strong>never used to train AI models</strong>.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="features">
    <div class="container">
      <h2>Everything teachers need to grade faster</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
              <path d="M12 18v-6" /><path d="M9 15l3-3 3 3" />
            </svg>
          </div>
          <h3>AI Transcription</h3>
          <p>
            Snap a photo or import a PDF. GradeVine's AI reads handwriting
            and digitizes every student response automatically.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h3>Keyword Matching</h3>
          <p>
            Define answer keywords per question and GradeVine highlights
            matches instantly. Spend less time reading, more time teaching.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M7.5 8.5h0M12 11.5h0M16.5 8.5h0" stroke-width="3" stroke-linecap="round" />
              <path d="M2 17l5-5 3 3 4-4 3 3 5-5" stroke-width="2" />
            </svg>
          </div>
          <h3>Quick Feedback</h3>
          <p>
            Save common feedback phrases and apply them with a tap.
            Give students detailed, consistent feedback in seconds.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3>Auto-Match Students</h3>
          <p>
            Scan a stack of papers and GradeVine automatically matches each
            assignment to the right student with 96% accuracy.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />
            </svg>
          </div>
          <h3>Grade by Question</h3>
          <p>
            See every student's answer to the same question side by side.
            Grade faster and more consistently than paper-by-paper review.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
            </svg>
          </div>
          <h3>Export Anywhere</h3>
          <p>
            Export grades and feedback as PDF, CSV, or directly to Google Drive.
            Share results with students, parents, or your records system.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <h3>Private & Secure</h3>
          <p>
            Student data stays on your device and syncs privately via iCloud.
            No third-party servers store your students' work.
          </p>
        </div>
      </div>
      <div class="section-cta">
        <a href="#" class="btn btn-primary">Get Started for Free</a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="how-it-works">
    <div class="container">
      <h2>How it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Scan</h3>
          <p>Take photos of handwritten assignments or import PDFs. Process an entire class set at once.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Transcribe</h3>
          <p>AI reads handwriting, digitizes every response, and matches pages to your roster.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Grade</h3>
          <p>Review by question, tap to assign points, and export to your gradebook. About 1 minute per student.</p>
        </div>
      </div>
      <div class="section-cta">
        <a href="#" class="btn btn-primary">Get Started for Free</a>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="pricing">
    <div class="container">
      <h2>Simple, credit-based pricing</h2>
      <p class="pricing-subtitle">Every feature is available on every plan. Credits power AI transcription — 1 credit per page scanned, or 1.5 credits per page with AI-assisted grading.</p>

      <!-- Free tier elevated -->
      <div class="free-tier-hero">
        <div class="free-tier-hero-content">
          <h3>Start free</h3>
          <div class="free-price">Free</div>
          <div class="credits">30 credits/month</div>
          <p class="credits-note">Enough for about 1 small class assignment. All features included.</p>
          <a href="#" class="btn btn-primary">Get Started for Free</a>
        </div>
      </div>

      <div class="upgrade-divider">
        <span>Need more credits?</span>
      </div>

      <!-- Billing toggle -->
      <div class="billing-toggle">
        <button class="toggle-btn active" data-period="monthly">Monthly</button>
        <button class="toggle-btn" data-period="annual">Annual</button>
      </div>

      <div class="pricing-grid-paid">
        <div class="pricing-card featured">
          <div class="badge">Most Popular</div>
          <h3>Standard</h3>
          <div class="price monthly-price">$4.99<span>/mo</span></div>
          <div class="price annual-price" style="display:none;">$49.99<span>/yr</span></div>
          <div class="annual-savings" style="display:none;">Save $9.89/year</div>
          <div class="credits">1,000 credits/month</div>
          <p class="credits-note">Unused credits roll over month to month.</p>
          <ul>
            <li>All features included</li>
            <li>Google Drive export</li>
            <li>Rollover credits</li>
          </ul>
        </div>
        <div class="pricing-card">
          <h3>Pro</h3>
          <div class="price monthly-price">$9.99<span>/mo</span></div>
          <div class="price annual-price" style="display:none;">$99.99<span>/yr</span></div>
          <div class="annual-savings" style="display:none;">Save $19.89/year</div>
          <div class="credits">5,000 credits/month</div>
          <p class="credits-note">Unused credits roll over month to month.</p>
          <ul>
            <li>Everything in Standard</li>
            <li>5x the credits</li>
            <li>Built for heavy workloads</li>
          </ul>
        </div>
      </div>

      <div class="credit-explainer">
        <h4>How credits work</h4>
        <div class="credit-examples">
          <div class="credit-example">
            <strong>1-page quiz, 20 students, with AI grading</strong>
            <span>30 credits</span>
            <span class="credit-tag free-tag">Free tier</span>
          </div>
          <div class="credit-example">
            <strong>4-page test, 30 students, with AI grading</strong>
            <span>180 credits</span>
            <span class="credit-tag standard-tag">Standard</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <span class="logo-text">GradeVine</span>
          <p>AI that grades papers, not writes them.</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h4>Product</h4>
            <a href="#features">Features</a>
            <a href="#pricing">Pricing</a>
            <a href="#">Download</a>
          </div>
          <div class="footer-col">
            <h4>Legal</h4>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
          </div>
          <div class="footer-col">
            <h4>Support</h4>
            <a href="mailto:support@gradevine.app">Contact</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} GradeVine. All rights reserved.</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: linear-gradient(
      135deg,
      var(--color-purple-deep),
      var(--color-purple)
    );
    box-shadow: 0 2px 12px rgba(80, 2, 247, 0.25);
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: #fff;
    text-decoration: none;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-button);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-red), var(--color-coral));
    color: #fff;
    box-shadow: 0 4px 12px rgba(255, 28, 54, 0.3);
  }

  .btn-primary:hover {
    box-shadow: 0 6px 20px rgba(255, 28, 54, 0.4);
    transform: translateY(-1px);
  }

  .btn-nav {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.2);
    color: #fff !important;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Hero */
  .hero {
    padding: 8rem 1.5rem 4rem;
    text-align: center;
    background: #fff;
  }

  .hero-content {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-gray-900);
  }

  .highlight {
    background: linear-gradient(
      135deg,
      var(--color-purple-deep),
      var(--color-purple)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    color: var(--color-gray-600);
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .hero-cta {
    margin-top: 2rem;
  }

  .hero-videos {
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .video-step {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .video-step.reverse {
    flex-direction: row-reverse;
  }

  .video-step-text {
    flex: 1;
    text-align: left;
  }

  .video-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, var(--color-purple-deep), var(--color-purple));
    color: #fff;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .video-step-text h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: 0.5rem;
  }

  .video-step-text p {
    font-size: 1rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .video-item {
    flex: 0 0 280px;
  }

  .video-item video {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: #000;
  }

  /* Privacy Banner */
  .privacy-banner {
    background: var(--color-purple-50);
    border-top: 1px solid var(--color-purple-light);
    border-bottom: 1px solid var(--color-purple-light);
    padding: 1rem 0;
  }

  .privacy-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .privacy-icon {
    flex-shrink: 0;
    color: var(--color-purple-deep);
  }

  .privacy-content p {
    font-size: 0.9rem;
    color: var(--color-gray-700);
    line-height: 1.5;
    margin: 0;
  }

  /* Container */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Section CTA */
  .section-cta {
    text-align: center;
    margin-top: 3rem;
  }

  /* Features */
  .features {
    padding: 5rem 0;
  }

  .features h2 {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 2rem;
    border-radius: var(--radius-card);
    background: #fff;
    border: 1px solid var(--color-gray-200);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .feature-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: var(--color-purple-light);
    border-radius: var(--radius-button);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-purple-deep);
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  /* How It Works */
  .how-it-works {
    padding: 5rem 0;
    background: var(--color-gray-50);
  }

  .how-it-works h2 {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .step {
    text-align: center;
    max-width: 240px;
  }

  .step-number {
    width: 48px;
    height: 48px;
    background: linear-gradient(
      135deg,
      var(--color-purple-deep),
      var(--color-purple)
    );
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    margin: 0 auto 1rem;
  }

  .step h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .step p {
    font-size: 0.9rem;
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  .step-arrow {
    color: var(--color-gray-300);
    flex-shrink: 0;
  }

  /* Pricing */
  .pricing {
    padding: 5rem 0;
  }

  .pricing h2 {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 700;
  }

  .pricing-subtitle {
    text-align: center;
    color: var(--color-gray-600);
    margin-top: 0.5rem;
    margin-bottom: 3rem;
    font-size: 1.05rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  /* Free tier hero */
  .free-tier-hero {
    max-width: 480px;
    margin: 0 auto 2rem;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-card);
    background: linear-gradient(135deg, var(--color-purple-50), #fff);
    border: 2px solid var(--color-purple-deep);
    box-shadow: 0 4px 24px rgba(80, 2, 247, 0.1);
    text-align: center;
  }

  .free-tier-hero h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .free-price {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-purple-deep);
    margin-bottom: 0.25rem;
  }

  .free-tier-hero .credits {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: 0.25rem;
  }

  .free-tier-hero .credits-note {
    font-size: 0.9rem;
    color: var(--color-gray-500);
    margin-bottom: 1.5rem;
    line-height: 1.4;
  }

  /* Upgrade divider */
  .upgrade-divider {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 700px;
    margin: 2rem auto;
  }

  .upgrade-divider::before,
  .upgrade-divider::after {
    content: '';
