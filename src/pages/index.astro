</style>

<script>
  const toggleBtns = document.querySelectorAll('.toggle-btn');
  const monthlyPrices = document.querySelectorAll('.monthly-price');
  const annualPrices = document.querySelectorAll('.annual-price');
  const annualSavings = document.querySelectorAll('.annual-savings');

  toggleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      toggleBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const period = btn.dataset.period;
      const showMonthly = period === 'monthly';

      monthlyPrices.forEach(el => el.style.display = showMonthly ? '' : 'none');
      annualPrices.forEach(el => el.style.display = showMonthly ? 'none' : '');
      annualSavings.forEach(el => el.style.display = showMonthly ? 'none' : '');
    });
  });

  // Credit calculator
  const calcStudents = document.getElementById('calc-students');
  const calcPages = document.getElementById('calc-pages');
  const calcAi = document.getElementById('calc-ai');
  const calcTotal = document.getElementById('calc-total');
  const calcPlan = document.getElementById('calc-plan');
  const calcAssignments = document.getElementById('calc-assignments');

  function updateCalc() {
    const students = Math.max(1, parseInt(calcStudents.value) || 1);
    const pages = Math.max(1, parseInt(calcPages.value) || 1);
    const aiOn = calcAi.classList.contains('active');
    const rate = aiOn ? 1.5 : 1;
    const total = Math.ceil(students * pages * rate);

    calcTotal.textContent = total.toLocaleString();

    const plans = [
      { name: 'Free', credits: 30, tagClass: 'free-tag' },
      { name: 'Standard', credits: 1000, tagClass: 'standard-tag' },
      { name: 'Pro', credits: 5000, tagClass: 'pro-tag' },
    ];

    const plan = plans.find(p => p.credits >= total) || plans[plans.length - 1];
    const assignments = Math.floor(plan.credits / total);

    calcAssignments.textContent = assignments;
    calcPlan.innerHTML =
      `<span class="credit-tag ${plan.tagClass}">${plan.name}</span>` +
      `<span>Up to <strong>${assignments}</strong> assignment${assignments !== 1 ? 's' : ''}/month</span>`;
  }

  const calcAiLabel = document.getElementById('calc-ai-label');

  calcStudents.addEventListener('input', updateCalc);
  calcPages.addEventListener('input', updateCalc);

  calcAi.addEventListener('click', () => {
    calcAi.classList.toggle('active');
    const isOn = calcAi.classList.contains('active');
    calcAi.setAttribute('aria-pressed', isOn);
    calcAiLabel.textContent = isOn ? '+0.5 credits/page' : 'Off';
    updateCalc();
  });

  document.querySelectorAll('.stepper-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target);
      const dir = parseInt(btn.dataset.dir);
      const min = parseInt(input.min) || 1;
      const max = parseInt(input.max) || 999;
      const next = Math.min(max, Math.max(min, (parseInt(input.value) || min) + dir));
      input.value = next;
      updateCalc();
    });
  });

  updateCalc();

  // Respect reduced-motion preference
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('video').forEach(v => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }

  // Carousel
  const carouselTrack = document.querySelector('.carousel-track');
  const carouselImages = document.querySelectorAll('.carousel-track img');
  const carouselDots = document.querySelectorAll('.carousel-dot');
  let currentSlide = 0;

  function goToSlide(index) {
    carouselImages.forEach(img => img.classList.remove('carousel-active'));
    carouselDots.forEach(dot => dot.classList.remove('active'));
    currentSlide = (index + carouselImages.length) % carouselImages.length;
    carouselImages[currentSlide].classList.add('carousel-active');
    carouselDots[currentSlide].classList.add('active');
  }

  // Initialize first slide
  if (carouselImages.length) goToSlide(0);

  // Click dots
  carouselDots.forEach((dot, i) => {
    dot.addEventListener('click', () => goToSlide(i));
  });

  // Swipe support
  if (carouselTrack) {
    let startX = 0;
    let startY = 0;
    let tracking = false;

    carouselTrack.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      tracking = true;
    }, { passive: true });

    carouselTrack.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        goToSlide(dx < 0 ? currentSlide + 1 : currentSlide - 1);
      }
    }, { passive: true });

    // Mouse drag support for desktop
    carouselTrack.addEventListener('mousedown', (e) => {
      startX = e.clientX;
      tracking = true;
      carouselTrack.style.cursor = 'grabbing';
    });

    window.addEventListener('mouseup', (e) => {
      if (!tracking) return;
      tracking = false;
      carouselTrack.style.cursor = '';
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) {
        goToSlide(dx < 0 ? currentSlide + 1 : currentSlide - 1);
      }
    });
  }
</script>
