---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Student Performance — Design Variations" description="5 variations of the Student Performance section">
<div class="pv-page">
  <header class="pv-header">
    <h1>Student Performance — Card + Sparkline Variations</h1>
    <p>Exploring card-based layouts with sparklines for the student performance section.</p>
  </header>

  <!-- ================================================================== -->
  <!-- VARIATION F: Card + Sparkline                                       -->
  <!-- ================================================================== -->
  <section class="pv-section">
    <div class="pv-label">VARIATION F</div>
    <h2>Card + Sparkline</h2>
    <p class="pv-desc">Each student in their own card. Large score top-left, trend pill top-right, wide sparkline with area fill across the bottom. Cards have a subtle left accent in score color.</p>

    <div class="pv-mock-bg">
      <div class="vf-grid">
        <!-- Sarah Chen: 92% improving -->
        <div class="vf-card" style="--ac: #34C759;">
          <div class="vf-card-accent"></div>
          <div class="vf-card-body">
            <div class="vf-card-top">
              <div class="vf-card-left">
                <span class="vf-card-score">92.0<span class="vf-card-pct">%</span></span>
                <span class="vf-card-name">Sarah Chen</span>
              </div>
              <span class="vf-pill vf-pill-up">↑ +5.2%</span>
            </div>
            <svg class="vf-spark" viewBox="0 0 200 48" preserveAspectRatio="none">
              <defs><linearGradient id="vf1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#34C759" stop-opacity="0.2"/><stop offset="100%" stop-color="#34C759" stop-opacity="0.02"/></linearGradient></defs>
              <path d="M0,40 L40,34 L80,36 L120,20 L160,10 L200,6 L200,48 L0,48Z" fill="url(#vf1)"/>
              <polyline points="0,40 40,34 80,36 120,20 160,10 200,6" fill="none" stroke="#34C759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- James Wright: 85% stable -->
        <div class="vf-card" style="--ac: #007AFF;">
          <div class="vf-card-accent"></div>
          <div class="vf-card-body">
            <div class="vf-card-top">
              <div class="vf-card-left">
                <span class="vf-card-score">85.3<span class="vf-card-pct">%</span></span>
                <span class="vf-card-name">James Wright</span>
              </div>
              <span class="vf-pill vf-pill-stable">→ +0.3%</span>
            </div>
            <svg class="vf-spark" viewBox="0 0 200 48" preserveAspectRatio="none">
              <defs><linearGradient id="vf2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#007AFF" stop-opacity="0.2"/><stop offset="100%" stop-color="#007AFF" stop-opacity="0.02"/></linearGradient></defs>
              <path d="M0,22 L40,26 L80,20 L120,24 L160,22 L200,21 L200,48 L0,48Z" fill="url(#vf2)"/>
              <polyline points="0,22 40,26 80,20 120,24 160,22 200,21" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Aisha Patel: 78% improving -->
        <div class="vf-card" style="--ac: #007AFF;">
          <div class="vf-card-accent"></div>
          <div class="vf-card-body">
            <div class="vf-card-top">
              <div class="vf-card-left">
                <span class="vf-card-score">78.0<span class="vf-card-pct">%</span></span>
                <span class="vf-card-name">Aisha Patel</span>
              </div>
              <span class="vf-pill vf-pill-up">↑ +3.7%</span>
            </div>
            <svg class="vf-spark" viewBox="0 0 200 48" preserveAspectRatio="none">
              <defs><linearGradient id="vf3" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#007AFF" stop-opacity="0.2"/><stop offset="100%" stop-color="#007AFF" stop-opacity="0.02"/></linearGradient></defs>
              <path d="M0,38 L40,32 L80,26 L120,20 L160,16 L200,12 L200,48 L0,48Z" fill="url(#vf3)"/>
              <polyline points="0,38 40,32 80,26 120,20 160,16 200,12" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Maria Lopez: 64% medium risk declining -->
        <div class="vf-card vf-card-risk" style="--ac: #FF9500;">
          <div class="vf-card-accent"></div>
          <div class="vf-card-body">
            <div class="vf-card-top">
              <div class="vf-card-left">
                <span class="vf-card-score" style="color:#FF9500;">64.2<span class="vf-card-pct">%</span></span>
                <span class="vf-card-name">Maria Lopez</span>
              </div>
              <span class="vf-pill vf-pill-down">↓ -8.1%</span>
            </div>
            <svg class="vf-spark" viewBox="0 0 200 48" preserveAspectRatio="none">
              <defs><linearGradient id="vf4" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FF9500" stop-opacity="0.2"/><stop offset="100%" stop-color="#FF9500" stop-opacity="0.02"/></linearGradient></defs>
              <path d="M0,10 L40,14 L80,20 L120,28 L160,36 L200,42 L200,48 L0,48Z" fill="url(#vf4)"/>
              <polyline points="0,10 40,14 80,20 120,28 160,36 200,42" fill="none" stroke="#FF9500" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Tyler Brooks: 38% critical declining -->
        <div class="vf-card vf-card-risk" style="--ac: #FF1C36;">
          <div class="vf-card-accent"></div>
          <div class="vf-card-body">
            <div class="vf-card-top">
              <div class="vf-card-left">
                <span class="vf-card-score" style="color:#FF1C36;">38.0<span class="vf-card-pct">%</span></span>
                <span class="vf-card-name">Tyler Brooks</span>
              </div>
              <span class="vf-pill vf-pill-down">↓ -12.4%</span>
            </div>
            <svg class="vf-spark" viewBox="0 0 200 48" preserveAspectRatio="none">
              <defs><linearGradient id="vf5" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FF1C36" stop-opacity="0.2"/><stop offset="100%" stop-color="#FF1C36" stop-opacity="0.02"/></linearGradient></defs>
              <path d="M0,8 L40,14 L80,24 L120,32 L160,38 L200,44 L200,48 L0,48Z" fill="url(#vf5)"/>
              <polyline points="0,8 40,14 80,24 120,32 160,38 200,44" fill="none" stroke="#FF1C36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- VARIATION G: Full-Bleed Sparkline Background                        -->
  <!-- ================================================================== -->
  <section class="pv-section">
    <div class="pv-label">VARIATION G</div>
    <h2>Full-Bleed Sparkline Background</h2>
    <p class="pv-desc">The sparkline becomes the card's background, rendered edge-to-edge behind the content. Score and delta overlay on top. Cards feel like mini stock tickers.</p>

    <div class="pv-mock-bg">
      <div class="vg-grid">
        <div class="vg-card">
          <svg class="vg-bg-spark" viewBox="0 0 300 80" preserveAspectRatio="none">
            <defs><linearGradient id="vg1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#34C759" stop-opacity="0.12"/><stop offset="100%" stop-color="#34C759" stop-opacity="0.02"/></linearGradient></defs>
            <path d="M0,65 L60,55 L120,58 L180,35 L240,18 L300,10 L300,80 L0,80Z" fill="url(#vg1)"/>
            <polyline points="0,65 60,55 120,58 180,35 240,18 300,10" fill="none" stroke="#34C759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
          </svg>
          <div class="vg-overlay">
            <div class="vg-top"><span class="vg-name">Sarah Chen</span><span class="vg-pill vg-pill-up">↑ +5.2%</span></div>
            <span class="vg-score">92.0%</span>
          </div>
        </div>
        <div class="vg-card">
          <svg class="vg-bg-spark" viewBox="0 0 300 80" preserveAspectRatio="none">
            <defs><linearGradient id="vg2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#007AFF" stop-opacity="0.12"/><stop offset="100%" stop-color="#007AFF" stop-opacity="0.02"/></linearGradient></defs>
            <path d="M0,36 L60,42 L120,32 L180,38 L240,35 L300,34 L300,80 L0,80Z" fill="url(#vg2)"/>
            <polyline points="0,36 60,42 120,32 180,38 240,35 300,34" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
          </svg>
          <div class="vg-overlay">
            <div class="vg-top"><span class="vg-name">James Wright</span><span class="vg-pill vg-pill-stable">→ +0.3%</span></div>
            <span class="vg-score">85.3%</span>
          </div>
        </div>
        <div class="vg-card">
          <svg class="vg-bg-spark" viewBox="0 0 300 80" preserveAspectRatio="none">
            <defs><linearGradient id="vg3b" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#007AFF" stop-opacity="0.12"/><stop offset="100%" stop-color="#007AFF" stop-opacity="0.02"/></linearGradient></defs>
            <path d="M0,62 L60,52 L120,42 L180,34 L240,26 L300,20 L300,80 L0,80Z" fill="url(#vg3b)"/>
            <polyline points="0,62 60,52 120,42 180,34 240,26 300,20" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
          </svg>
          <div class="vg-overlay">
            <div class="vg-top"><span class="vg-name">Aisha Patel</span><span class="vg-pill vg-pill-up">↑ +3.7%</span></div>
            <span class="vg-score">78.0%</span>
          </div>
        </div>
        <div class="vg-card vg-card-risk">
          <svg class="vg-bg-spark" viewBox="0 0 300 80" preserveAspectRatio="none">
            <defs><linearGradient id="vg4b" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FF9500" stop-opacity="0.12"/><stop offset="100%" stop-color="#FF9500" stop-opacity="0.02"/></linearGradient></defs>
            <path d="M0,16 L60,22 L120,34 L180,48 L240,60 L300,68 L300,80 L0,80Z" fill="url(#vg4b)"/>
            <polyline points="0,16 60,22 120,34 180,48 240,60 300,68" fill="none" stroke="#FF9500" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
          </svg>
          <div class="vg-overlay">
            <div class="vg-top"><span class="vg-name">Maria Lopez</span><span class="vg-pill vg-pill-down">↓ -8.1%</span></div>
            <span class="vg-score" style="color:#FF9500;">64.2%</span>
          </div>
        </div>
        <div class="vg-card vg-card-risk">
          <svg class="vg-bg-spark" viewBox="0 0 300 80" preserveAspectRatio="none">
            <defs><linearGradient id="vg5b" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FF1C36" stop-opacity="0.12"/><stop offset="100%" stop-color="#FF1C36" stop-opacity="0.02"/></linearGradient></defs>
            <path d="M0,12 L60,22 L120,38 L180,52 L240,62 L300,72 L300,80 L0,80Z" fill="url(#vg5b)"/>
            <polyline points="0,12 60,22 120,38 180,52 240,62 300,72" fill="none" stroke="#FF1C36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
          </svg>
          <div class="vg-overlay">
            <div class="vg-top"><span class="vg-name">Tyler Brooks</span><span class="vg-pill vg-pill-down">↓ -12.4%</span></div>
            <span class="vg-score" style="color:#FF1C36;">38.0%</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- VARIATION H: Compact Row Cards with Ring + Spark                    -->
  <!-- ================================================================== -->
  <section class="pv-section">
    <div class="pv-label">VARIATION H</div>
    <h2>Row Cards with Ring + Spark</h2>
    <p class="pv-desc">Full-width row cards. Left: mini ring chart. Center: name + assignment scores as dots. Right: sparkline + delta pill. Combines density with visual richness.</p>

    <div class="pv-mock-bg">
      <div class="vh-list">
        <div class="vh-row">
          <div class="vh-ring"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#f0f0f0" stroke-width="3.5"/><circle cx="20" cy="20" r="16" fill="none" stroke="#34C759" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="92.5 100.5" transform="rotate(-90 20 20)"/></svg><span class="vh-ring-val">92</span></div>
          <div class="vh-info"><span class="vh-name">Sarah Chen</span><div class="vh-dots"><span class="vh-dot" style="background:#34C759;" title="88%"></span><span class="vh-dot" style="background:#34C759;" title="90%"></span><span class="vh-dot" style="background:#34C759;" title="95%"></span><span class="vh-dot" style="background:#34C759;" title="96%"></span></div></div>
          <svg class="vh-spark" viewBox="0 0 80 28"><polyline points="2,22 20,18 40,20 60,10 78,4" fill="none" stroke="#34C759" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh-pill vh-pill-up">↑ +5.2%</span>
        </div>
        <div class="vh-row">
          <div class="vh-ring"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#f0f0f0" stroke-width="3.5"/><circle cx="20" cy="20" r="16" fill="none" stroke="#007AFF" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="85.5 100.5" transform="rotate(-90 20 20)"/></svg><span class="vh-ring-val">85</span></div>
          <div class="vh-info"><span class="vh-name">James Wright</span><div class="vh-dots"><span class="vh-dot" style="background:#007AFF;" title="84%"></span><span class="vh-dot" style="background:#007AFF;" title="86%"></span><span class="vh-dot" style="background:#007AFF;" title="85%"></span><span class="vh-dot" style="background:#007AFF;" title="86%"></span></div></div>
          <svg class="vh-spark" viewBox="0 0 80 28"><polyline points="2,14 20,16 40,12 60,14 78,13" fill="none" stroke="#007AFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh-pill vh-pill-stable">→ +0.3%</span>
        </div>
        <div class="vh-row">
          <div class="vh-ring"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#f0f0f0" stroke-width="3.5"/><circle cx="20" cy="20" r="16" fill="none" stroke="#007AFF" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="78.5 100.5" transform="rotate(-90 20 20)"/></svg><span class="vh-ring-val">78</span></div>
          <div class="vh-info"><span class="vh-name">Aisha Patel</span><div class="vh-dots"><span class="vh-dot" style="background:#FF9500;" title="72%"></span><span class="vh-dot" style="background:#FF9500;" title="74%"></span><span class="vh-dot" style="background:#007AFF;" title="80%"></span><span class="vh-dot" style="background:#34C759;" title="86%"></span></div></div>
          <svg class="vh-spark" viewBox="0 0 80 28"><polyline points="2,24 20,20 40,16 60,12 78,8" fill="none" stroke="#007AFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh-pill vh-pill-up">↑ +3.7%</span>
        </div>
        <div class="vh-row vh-row-risk">
          <div class="vh-ring"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#f0f0f0" stroke-width="3.5"/><circle cx="20" cy="20" r="16" fill="none" stroke="#FF9500" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="64.3 100.5" transform="rotate(-90 20 20)"/></svg><span class="vh-ring-val" style="color:#FF9500;">64</span></div>
          <div class="vh-info"><span class="vh-name">Maria Lopez</span><div class="vh-dots"><span class="vh-dot" style="background:#007AFF;" title="72%"></span><span class="vh-dot" style="background:#FF9500;" title="68%"></span><span class="vh-dot" style="background:#FF1C36;" title="58%"></span><span class="vh-dot" style="background:#FF1C36;" title="55%"></span></div></div>
          <svg class="vh-spark" viewBox="0 0 80 28"><polyline points="2,6 20,8 40,12 60,20 78,24" fill="none" stroke="#FF9500" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh-pill vh-pill-down">↓ -8.1%</span>
        </div>
        <div class="vh-row vh-row-risk">
          <div class="vh-ring"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#f0f0f0" stroke-width="3.5"/><circle cx="20" cy="20" r="16" fill="none" stroke="#FF1C36" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="38.2 100.5" transform="rotate(-90 20 20)"/></svg><span class="vh-ring-val" style="color:#FF1C36;">38</span></div>
          <div class="vh-info"><span class="vh-name">Tyler Brooks</span><div class="vh-dots"><span class="vh-dot" style="background:#FF1C36;" title="45%"></span><span class="vh-dot" style="background:#FF1C36;" title="42%"></span><span class="vh-dot" style="background:#FF1C36;" title="30%"></span><span class="vh-dot" style="background:#FF1C36;" title="28%"></span></div></div>
          <svg class="vh-spark" viewBox="0 0 80 28"><polyline points="2,4 20,8 40,16 60,20 78,24" fill="none" stroke="#FF1C36" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh-pill vh-pill-down">↓ -12.4%</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- VARIATION I: Stacked Card with Score Bar + Spark Overlay            -->
  <!-- ================================================================== -->
  <section class="pv-section">
    <div class="pv-label">VARIATION I</div>
    <h2>Score Bar + Spark Overlay</h2>
    <p class="pv-desc">Each card has a thick gradient score bar at the top (sized to percentage), with the sparkline overlaid on it. Name and delta sit below. The bar IS the sparkline background.</p>

    <div class="pv-mock-bg">
      <div class="vi-grid">
        <div class="vi-card">
          <div class="vi-bar-area">
            <div class="vi-bar" style="width:92%; background: linear-gradient(90deg, #34C75966, #34C75922);"></div>
            <svg class="vi-spark-overlay" viewBox="0 0 200 36" preserveAspectRatio="none"><polyline points="0,30 40,24 80,26 120,14 160,6 200,2" fill="none" stroke="#34C759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="vi-bottom"><span class="vi-name">Sarah Chen</span><span class="vi-score">92.0%</span><span class="vi-delta vi-up">↑ +5.2%</span></div>
        </div>
        <div class="vi-card">
          <div class="vi-bar-area">
            <div class="vi-bar" style="width:85%; background: linear-gradient(90deg, #007AFF66, #007AFF22);"></div>
            <svg class="vi-spark-overlay" viewBox="0 0 200 36" preserveAspectRatio="none"><polyline points="0,18 40,22 80,14 120,20 160,17 200,16" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="vi-bottom"><span class="vi-name">James Wright</span><span class="vi-score">85.3%</span><span class="vi-delta vi-stable">→ +0.3%</span></div>
        </div>
        <div class="vi-card">
          <div class="vi-bar-area">
            <div class="vi-bar" style="width:78%; background: linear-gradient(90deg, #007AFF66, #007AFF22);"></div>
            <svg class="vi-spark-overlay" viewBox="0 0 200 36" preserveAspectRatio="none"><polyline points="0,32 40,26 80,20 120,14 160,10 200,6" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="vi-bottom"><span class="vi-name">Aisha Patel</span><span class="vi-score">78.0%</span><span class="vi-delta vi-up">↑ +3.7%</span></div>
        </div>
        <div class="vi-card vi-card-risk">
          <div class="vi-bar-area">
            <div class="vi-bar" style="width:64%; background: linear-gradient(90deg, #FF950066, #FF950022);"></div>
            <svg class="vi-spark-overlay" viewBox="0 0 200 36" preserveAspectRatio="none"><polyline points="0,6 40,10 80,16 120,22 160,28 200,34" fill="none" stroke="#FF9500" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="vi-bottom"><span class="vi-name">Maria Lopez</span><span class="vi-score" style="color:#FF9500;">64.2%</span><span class="vi-delta vi-down">↓ -8.1%</span></div>
        </div>
        <div class="vi-card vi-card-risk">
          <div class="vi-bar-area">
            <div class="vi-bar" style="width:38%; background: linear-gradient(90deg, #FF1C3666, #FF1C3622);"></div>
            <svg class="vi-spark-overlay" viewBox="0 0 200 36" preserveAspectRatio="none"><polyline points="0,4 40,10 80,18 120,26 160,30 200,34" fill="none" stroke="#FF1C36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="vi-bottom"><span class="vi-name">Tyler Brooks</span><span class="vi-score" style="color:#FF1C36;">38.0%</span><span class="vi-delta vi-down">↓ -12.4%</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- VARIATION J: Wide Card with Assignment Labels on Sparkline          -->
  <!-- ================================================================== -->
  <section class="pv-section">
    <div class="pv-label">VARIATION J</div>
    <h2>Labeled Sparkline</h2>
    <p class="pv-desc">Like F but wider (single column). The sparkline has labeled data points showing each assignment score, so you can see exactly what happened. Most informative variant.</p>

    <div class="pv-mock-bg">
      <div class="vj-list">
        <div class="vj-card" style="--ac: #34C759;">
          <div class="vj-card-accent"></div>
          <div class="vj-card-body">
            <div class="vj-top"><div class="vj-left"><span class="vj-score">92.0<span class="vj-pct">%</span></span><span class="vj-name">Sarah Chen</span></div><span class="vj-pill vj-pill-up">↑ +5.2%</span></div>
            <div class="vj-spark-area">
              <svg class="vj-spark" viewBox="0 0 400 56" preserveAspectRatio="none">
                <defs><linearGradient id="vj1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#34C759" stop-opacity="0.15"/><stop offset="100%" stop-color="#34C759" stop-opacity="0"/></linearGradient></defs>
                <path d="M40,44 L140,38 L260,40 L360,14 L360,56 L40,56Z" fill="url(#vj1)"/>
                <polyline points="40,44 140,38 260,40 360,14" fill="none" stroke="#34C759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
