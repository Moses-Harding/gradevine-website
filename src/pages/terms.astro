---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service - GradeVine" description="GradeVine terms of service.">
  <div class="page">
    <h1>Terms of Service</h1>
    <p class="updated">Last updated: March 2026</p>
    <p>Terms of service content goes here.</p>
    <p><a href="/">Back to home</a></p>
  </div>
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .updated {
    color: var(--color-gray-500);
    margin-bottom: 2rem;
  }

  p {
    line-height: 1.7;
    margin-bottom: 1rem;
  }
</style>
